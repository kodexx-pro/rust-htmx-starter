DATABASE_URL=postgres://postgres:postgres@localhost:5432/app_starter
APP_URL=http://localhost:3000
# Mínimo de 64 caracteres para assinar cookies com HMAC-SHA512
APP_SECRET=troque-esta-chave-por-uma-string-aleatoria-com-pelo-menos-64-bytes-em-producao
RESEND_API_KEY=re_123456789
EMAIL_FROM=Sistema <onboarding@resend.dev>
# Opcional: login com Google OIDC (callback: ${APP_URL}/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Opcional: e-mails de administradores da plataforma separados por vírgula
ADMIN_EMAILS=
# Observabilidade (tracing): filtro inicial e formato (compact | json)
RUST_LOG=web=info,tower_http=info,sqlx=warn
LOG_FORMAT=compact

# Opcional: segredo do webhook Stripe (whsec_...) para sincronizar assinaturas por organização
STRIPE_WEBHOOK_SECRET=

# Opcional: token Bearer para proteger GET /metrics (se vazio, aberto para scraping local)
METRICS_TOKEN=

# Opcional: limites de requisições por janela (rate limiting via PgCache UNLOGGED)
RATE_LIMIT_WINDOW_SECS=60
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_ANALYTICS_MAX=120
